# GridAware API (FastAPI) — copy to .env locally; never commit real secrets.

# Optional: SQLite path for network index (default: network.db in gridaware_network_starter)
# NETWORK_DB=network.db

# AI Outage Assistant (Google Gemini via OpenAI-compatible endpoint)
# When unset, /prediction works normally; the assistant shows an unconfigured state.
GEMINI_API_KEY=

# Optional Gemini Flash model (default: gemini-3.1-flash-lite; auto-fallback if overloaded)
# GEMINI_MODEL=gemini-3.1-flash-lite

# Next.js proxy to FastAPI (optional)
# BACKEND_URL=http://127.0.0.1:8000
